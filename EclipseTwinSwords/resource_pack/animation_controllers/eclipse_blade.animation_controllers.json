{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.eclipse.blade": {
      "initial_state": "third_person",
      "states": {
        "third_person": {
          "animations": [
            "third_person"
          ],
          "transitions": [
            {
              "first_person": "c.is_first_person"
            }
          ]
        },
        "first_person": {
          "animations": [
            "first_person"
          ],
          "transitions": [
            {
              "third_person": "!c.is_first_person"
            }
          ]
        }
      }
    }
  }
}
