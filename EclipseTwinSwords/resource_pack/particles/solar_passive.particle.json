{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:solar_passive",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, math.floor(3 * v.dn))"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.8 * v.sc",
        "surface_only": true,
        "direction": [
          "math.random(-0.3, 0.3)",
          1,
          "math.random(-0.3, 0.3)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.3)"
      },
      "minecraft:particle_initial_speed": "math.random(0.2, 0.6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.15,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + 0.06 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)",
          "(0.05 + 0.06 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.333 ? 0 : (v.particle_random_3 < 0.667 ? 128 : 192))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              1,
              0.97,
              0.85,
              0
            ],
            "0.20": [
              1,
              0.86,
              0.48,
              1
            ],
            "0.70": [
              1,
              0.66,
              0.26,
              0.8
            ],
            "1.00": [
              1,
              0.5,
              0.15,
              0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
