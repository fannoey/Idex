{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:void_trail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.dir ?? { variable.dir.x = 0; variable.dir.y = 0; variable.dir.z = 1; };"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, math.floor(3 * v.dn))"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.5 * v.sc",
        "surface_only": false,
        "direction": [
          "-v.dir.x + math.random(-0.5, 0.5)",
          "-v.dir.y + math.random(-0.5, 0.5)",
          "-v.dir.z + math.random(-0.5, 0.5)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.45, 0.8)"
      },
      "minecraft:particle_initial_speed": "math.random(0.5, 1.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.2,
          0
        ],
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.28 + 0.2 * v.particle_random_2) * v.sc * (0.6 + 0.4 * (v.particle_age / v.particle_lifetime))",
          "(0.28 + 0.2 * v.particle_random_2) * v.sc * (0.6 + 0.4 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.250 ? 0 : (v.particle_random_3 < 0.500 ? 64 : (v.particle_random_3 < 0.750 ? 128 : 192)))",
            64
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              0.3,
              0.1,
              0.55,
              0.0
            ],
            "0.15": [
              0.2,
              0.05,
              0.38,
              0.8
            ],
            "1.00": [
              0.05,
              0.0,
              0.1,
              0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
