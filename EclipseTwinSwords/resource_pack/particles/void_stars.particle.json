{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:void_stars",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.rd = variable.radius ?? 0.4; variable.spd = variable.speed ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, math.floor(8 * v.dn))"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "v.rd",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.2)"
      },
      "minecraft:particle_initial_speed": "math.random(0.6, 3.5) * v.spd",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.25,
          0
        ],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + 0.09 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)",
          "(0.05 + 0.09 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.333 ? 128 : (v.particle_random_3 < 0.667 ? 256 : 384))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-90, 90)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 < 0.6 ? 0.7 : 0.78)",
          "(v.particle_random_4 < 0.6 ? 0.82 : 0.5)",
          "(v.particle_random_4 < 0.6 ? 1.0 : 1.0)",
          "math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ]
      }
    }
  }
}
