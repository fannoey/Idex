{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:eclipse_sun",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/sun_disc"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.lf = variable.life ?? 1.6; variable.vel ?? { variable.vel.x = 0; variable.vel.y = 0; variable.vel.z = 0; };"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.vel.x * v.particle_age",
          "v.vel.y * v.particle_age",
          "v.vel.z * v.particle_age"
        ],
        "rotation": "v.particle_age * 40"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.5 * v.sc * (1 - math.pow(math.max(0, 1 - v.particle_age * 3), 3)) * (1 + 0.05 * math.sin(v.particle_age * 1100))",
          "1.5 * v.sc * (1 - math.pow(math.max(0, 1 - v.particle_age * 3), 3)) * (1 + 0.05 * math.sin(v.particle_age * 1100))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp((v.lf - v.particle_age) * 8, 0, 1)"
        ]
      }
    }
  }
}
