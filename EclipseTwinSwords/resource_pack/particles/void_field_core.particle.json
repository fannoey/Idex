{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:void_field_core",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/eclipse/void_core"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.lf = variable.life ?? 6.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          0.9,
          0
        ],
        "rotation": "v.particle_age * -200"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sc * 0.9 * (1 + 0.12 * math.sin(v.particle_age * 540)) * (1 - 0.35 * math.pow(math.max(0, 1 - v.particle_age * 6), 2))",
          "v.sc * 0.9 * (1 + 0.12 * math.sin(v.particle_age * 540)) * (1 - 0.35 * math.pow(math.max(0, 1 - v.particle_age * 6), 2))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp(math.min(v.particle_age * 4, (v.lf - v.particle_age) * 2), 0, 1)"
        ]
      }
    }
  }
}
