{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:solar_spear_fall",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/spear"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.lf = variable.life ?? 0.3; variable.ht = variable.height ?? 16.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          "3.2 * v.sc + v.ht * (1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime))",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.8 * v.sc",
          "3.2 * v.sc"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 128,
          "texture_height": 512,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            512
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.min(1, (v.particle_age / v.particle_lifetime) * 5)"
        ]
      }
    }
  }
}
