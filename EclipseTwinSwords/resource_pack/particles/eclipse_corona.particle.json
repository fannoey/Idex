{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:eclipse_corona",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/corona"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.lf = variable.life ?? 1.2;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          0,
          0
        ],
        "rotation": "v.particle_age * 25"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "4.4 * v.sc * (1 - math.pow(math.max(0, 1 - v.particle_age * 5), 2)) * (1 + 0.05 * math.sin(v.particle_age * 1300))",
          "4.4 * v.sc * (1 - math.pow(math.max(0, 1 - v.particle_age * 5), 2)) * (1 + 0.05 * math.sin(v.particle_age * 1300))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            512,
            512
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp((v.lf - v.particle_age) * 5, 0, 1)"
        ]
      }
    }
  }
}
