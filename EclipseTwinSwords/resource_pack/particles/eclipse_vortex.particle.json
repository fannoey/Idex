{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:eclipse_vortex",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.lf = variable.life ?? 1.5; variable.rd = variable.radius ?? 3.0;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "40 * v.dn",
        "max_particles": 90
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.lf"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.0)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.rd * (0.75 + 0.4 * v.particle_random_2) * (1 - 0.35 * (v.particle_age / v.particle_lifetime)) * math.cos(v.particle_random_1 * 360 + v.particle_age * 300)",
          "(v.particle_random_3 - 0.5) * 1.6 + 0.8 * (v.particle_age / v.particle_lifetime)",
          "v.rd * (0.75 + 0.4 * v.particle_random_2) * (1 - 0.35 * (v.particle_age / v.particle_lifetime)) * math.sin(v.particle_random_1 * 360 + v.particle_age * 300)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.07 + 0.08 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)",
          "(0.07 + 0.08 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.333 ? 0 : (v.particle_random_3 < 0.667 ? 128 : 256))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 < 0.5 ? 1.0 : 0.78)",
          "(v.particle_random_4 < 0.5 ? 0.9 : 0.5)",
          "(v.particle_random_4 < 0.5 ? 0.62 : 1.0)",
          "math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ]
      }
    }
  }
}
