{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:solar_pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.rd = variable.radius ?? 3.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.floor(18 * v.dn)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "v.rd * 0.7",
        "plane_normal": [
          0,
          1,
          0
        ],
        "surface_only": false,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.55)"
      },
      "minecraft:particle_initial_speed": "math.random(9, 18)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.7 + 0.6 * v.particle_random_1) * v.sc * (1 - (v.particle_age / v.particle_lifetime))",
          "0.05 * v.sc"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              1,
              1,
              0.95,
              1
            ],
            "0.50": [
              1,
              0.8,
              0.35,
              0.8
            ],
            "1.00": [
              1,
              0.5,
              0.15,
              0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
