{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:void_moon_corona",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/corona"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.lf = variable.life ?? 1.4; variable.vel ?? { variable.vel.x = 0; variable.vel.y = 0; variable.vel.z = 0; };"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.vel.x * v.particle_age",
          "v.vel.y * v.particle_age + 0.15 * math.sin(v.particle_age * 240)",
          "v.vel.z * v.particle_age"
        ],
        "rotation": "v.particle_age * 30"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "5.9 * v.sc * (1 - math.pow(math.max(0, 1 - v.particle_age * 3), 3)) * (1 + 0.04 * math.sin(v.particle_age * 900))",
          "5.9 * v.sc * (1 - math.pow(math.max(0, 1 - v.particle_age * 3), 3)) * (1 + 0.04 * math.sin(v.particle_age * 900))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            512,
            512
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.62,
          0.42,
          1.0,
          "math.clamp((v.lf - v.particle_age) * 6, 0, 1) * math.min(1, v.particle_age * 3)"
        ]
      }
    }
  }
}
