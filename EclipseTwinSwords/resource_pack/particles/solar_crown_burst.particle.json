{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:solar_crown_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/sun_halo"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.lf = variable.life ?? 0.6; variable.dir ?? { variable.dir.x = 0; variable.dir.y = 0; variable.dir.z = 1; };"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          0,
          0
        ],
        "rotation": "v.particle_age * 120"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sc * (0.4 + 2.4 * (1 - math.pow(1 - (v.particle_age / v.particle_lifetime), 3)))",
          "v.sc * (0.4 + 2.4 * (1 - math.pow(1 - (v.particle_age / v.particle_lifetime), 3)))"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            512,
            512
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.dir.x",
            "v.dir.y",
            "v.dir.z"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              1,
              1,
              0.9,
              1
            ],
            "0.30": [
              1,
              0.82,
              0.4,
              0.9
            ],
            "1.00": [
              1,
              0.5,
              0.15,
              0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
