{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:eclipse_ready",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.floor(20 * v.dn)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.4 * v.sc",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.9)"
      },
      "minecraft:particle_initial_speed": "math.random(2, 5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.5,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.07 + 0.1 * v.particle_random_2) * v.sc * (1 - (v.particle_age / v.particle_lifetime))",
          "(0.07 + 0.1 * v.particle_random_2) * v.sc * (1 - (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.333 ? 128 : (v.particle_random_3 < 0.667 ? 192 : 256))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-180, 180)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 < 0.5 ? 1.0 : 0.78)",
          "(v.particle_random_4 < 0.5 ? 0.9 : 0.5)",
          "(v.particle_random_4 < 0.5 ? 0.62 : 1.0)",
          "1 - (v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
