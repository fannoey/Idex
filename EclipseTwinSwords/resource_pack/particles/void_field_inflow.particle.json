{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:void_field_inflow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.lf = variable.life ?? 6.0; variable.rd = variable.radius ?? 5.0;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "16 * v.dn",
        "max_particles": 40
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.lf"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 1.4)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.rd * (1 - (v.particle_age / v.particle_lifetime)) * math.cos(v.particle_random_1 * 360 + v.particle_age * 160)",
          "0.15 + 0.5 * math.sin((v.particle_age / v.particle_lifetime) * 180) * v.particle_random_2",
          "v.rd * (1 - (v.particle_age / v.particle_lifetime)) * math.sin(v.particle_random_1 * 360 + v.particle_age * 160)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.06 + 0.06 * v.particle_random_2) * v.sc * (0.4 + (v.particle_age / v.particle_lifetime))",
          "(0.06 + 0.06 * v.particle_random_2) * v.sc * (0.4 + (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.333 ? 0 : (v.particle_random_3 < 0.667 ? 256 : 128))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 < 0.7 ? 0.78 : 0.7)",
          "(v.particle_random_4 < 0.7 ? 0.5 : 0.82)",
          "(v.particle_random_4 < 0.7 ? 1.0 : 1.0)",
          "math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ]
      }
    }
  }
}
