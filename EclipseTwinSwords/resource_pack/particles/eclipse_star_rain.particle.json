{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:eclipse_star_rain",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.lf = variable.life ?? 1.4; variable.rd = variable.radius ?? 10.0; variable.ht = variable.height ?? 9.0;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "30 * v.dn",
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.lf"
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          "v.ht",
          0
        ],
        "radius": "v.rd",
        "plane_normal": [
          0,
          1,
          0
        ],
        "surface_only": false,
        "direction": [
          0,
          -1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 1.6)"
      },
      "minecraft:particle_initial_speed": "math.random(3, 6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -2,
          0
        ],
        "linear_drag_coefficient": 0.3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.07 + 0.09 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)",
          "(0.07 + 0.09 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.250 ? 128 : (v.particle_random_3 < 0.500 ? 192 : (v.particle_random_3 < 0.750 ? 256 : 384)))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-120, 120)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 < 0.5 ? 1.0 : 0.78)",
          "(v.particle_random_4 < 0.5 ? 0.9 : 0.5)",
          "(v.particle_random_4 < 0.5 ? 0.62 : 1.0)",
          "math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ]
      }
    }
  }
}
