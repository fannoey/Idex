{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:void_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.rd = variable.radius ?? 4.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.floor(12 * v.dn)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "v.rd * 0.5",
        "plane_normal": [
          0,
          1,
          0
        ],
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.4)"
      },
      "minecraft:particle_initial_speed": "math.random(2, 6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.6 + 0.5 * v.particle_random_2) * v.sc * (0.5 + (v.particle_age / v.particle_lifetime))",
          "(0.6 + 0.5 * v.particle_random_2) * v.sc * (0.5 + (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.250 ? 0 : (v.particle_random_3 < 0.500 ? 64 : (v.particle_random_3 < 0.750 ? 128 : 192)))",
            64
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-50, 50)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              0.25,
              0.08,
              0.45,
              0.0
            ],
            "0.10": [
              0.16,
              0.04,
              0.3,
              0.85
            ],
            "1.00": [
              0.04,
              0.0,
              0.08,
              0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
