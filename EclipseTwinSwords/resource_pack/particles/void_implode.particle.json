{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:void_implode",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.rd = variable.radius ?? 1.5;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.floor(14 * v.dn)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "v.rd",
        "surface_only": true,
        "direction": "inwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.18, 0.3)"
      },
      "minecraft:particle_initial_speed": "v.rd * 4",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.4 + 0.3 * v.particle_random_1) * v.sc * (1 - (v.particle_age / v.particle_lifetime) * 0.7)",
          "0.04 * v.sc"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 < 0.5 ? 0.78 : 0.7)",
          "(v.particle_random_4 < 0.5 ? 0.5 : 0.82)",
          "(v.particle_random_4 < 0.5 ? 1.0 : 1.0)",
          "math.min(1, (v.particle_age / v.particle_lifetime) * 4)"
        ]
      }
    }
  }
}
