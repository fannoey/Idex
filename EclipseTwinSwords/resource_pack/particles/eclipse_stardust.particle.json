{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:eclipse_stardust",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.rd = variable.radius ?? 1.2;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, math.floor(3 * v.dn))"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "v.rd",
        "surface_only": true,
        "direction": [
          "math.random(-0.4, 0.4)",
          "math.random(0.2, 1)",
          "math.random(-0.4, 0.4)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.9, 1.5)"
      },
      "minecraft:particle_initial_speed": "math.random(0.15, 0.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + 0.08 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)",
          "(0.05 + 0.08 * v.particle_random_2) * v.sc * math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_3 < 0.250 ? 128 : (v.particle_random_3 < 0.500 ? 192 : (v.particle_random_3 < 0.750 ? 256 : 384)))",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-90, 90)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 < 0.5 ? 1.0 : 0.78)",
          "(v.particle_random_4 < 0.5 ? 0.9 : 0.5)",
          "(v.particle_random_4 < 0.5 ? 0.62 : 1.0)",
          "math.sin((v.particle_age / v.particle_lifetime) * 180)"
        ]
      }
    }
  }
}
