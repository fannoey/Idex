{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:eclipse_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/fx_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.dn = variable.density ?? 1.0; variable.rd = variable.radius ?? 0.8; variable.spd = variable.speed ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.floor(48 * v.dn)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "v.rd",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 1.1)"
      },
      "minecraft:particle_initial_speed": "math.random(8, 22) * v.spd",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -2,
          0
        ],
        "linear_drag_coefficient": 2.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.5 + 0.6 * v.particle_random_1) * v.sc * (1 - (v.particle_age / v.particle_lifetime))",
          "0.06 * v.sc * (1 - (v.particle_age / v.particle_lifetime) * 0.5)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_4 < 0.5 ? 1.0 : 0.78)",
          "(v.particle_random_4 < 0.5 ? 0.9 : 0.5)",
          "(v.particle_random_4 < 0.5 ? 0.62 : 1.0)",
          "1 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
