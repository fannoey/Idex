{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:void_beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/eclipse/beam"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.sc = variable.scale ?? 1.0; variable.lf = variable.life ?? 0.5; variable.ht = variable.height ?? 14.0; variable.al = variable.alpha ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          "v.ht * 0.5",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.9 * v.sc * (1 - 0.6 * (v.particle_age / v.particle_lifetime)) * (1 + 0.2 * math.sin(v.particle_age * 2400))",
          "v.ht * 0.5"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 64,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.00": [
              0.9,
              0.8,
              1.0,
              "v.al"
            ],
            "0.30": [
              0.62,
              0.32,
              1.0,
              "v.al"
            ],
            "1.00": [
              0.3,
              0.1,
              0.8,
              0
            ]
          },
          "interpolant": "(v.particle_age / v.particle_lifetime)"
        }
      }
    }
  }
}
