{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "idex:reaper_mini_crescent",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/reaper/crescent"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 3)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": "(variable.radius > 0 ? variable.radius : 0.6)",
        "plane_normal": "y"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 2.0)"
      },
      "minecraft:particle_initial_speed": "math.random(0.2, 0.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.5,
          0
        ],
        "linear_drag_coefficient": 0.9
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-120, 120)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.random(0.35, 0.7) * (variable.size > 0 ? variable.size : 1)",
          "math.random(0.35, 0.7) * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "rotate_xyz"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1",
          "1",
          "1",
          "math.clamp(math.min(v.particle_age / v.particle_lifetime / 0.15, (1 - v.particle_age / v.particle_lifetime) / 0.4), 0, 1)"
        ]
      }
    }
  }
}