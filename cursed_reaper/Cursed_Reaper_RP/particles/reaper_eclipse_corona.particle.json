{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "idex:reaper_eclipse_corona",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/reaper/corona"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 5)"
      },
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_initial_spin": {
        "rotation": 0,
        "rotation_rate": 12
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 8) * (1.0 + 0.04 * math.sin(v.particle_age * 140))",
          "(variable.size > 0 ? variable.size : 8) * (1.0 + 0.04 * math.sin(v.particle_age * 140))"
        ],
        "facing_camera_mode": "lookat_xyz"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1",
          "1",
          "1",
          "math.clamp(math.min(v.particle_age / 0.8, (v.particle_lifetime - v.particle_age) / 0.8), 0, 1)"
        ]
      }
    }
  }
}