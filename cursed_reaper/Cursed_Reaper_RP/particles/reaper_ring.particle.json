{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "idex:reaper_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/reaper/ring"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0.06,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 0.6)"
      },
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 2) * (0.35 + 0.65 * math.sqrt(v.particle_age / v.particle_lifetime))",
          "(variable.size > 0 ? variable.size : 2) * (0.35 + 0.65 * math.sqrt(v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "emitter_transform_xz"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.cr + variable.cg + variable.cb > 0) ? variable.cr : 1.000",
          "(variable.cr + variable.cg + variable.cb > 0) ? variable.cg : 0.118",
          "(variable.cr + variable.cg + variable.cb > 0) ? variable.cb : 0.118",
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) / 0.08, (1 - v.particle_age / v.particle_lifetime) / 0.55), 0, 1)"
        ]
      }
    }
  }
}