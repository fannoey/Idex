{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "idex:reaper_sparks",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/reaper/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 14)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "(variable.radius > 0 ? variable.radius : 0.15)",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.25, 0.5)"
      },
      "minecraft:particle_initial_speed": "math.random(3, 7) * (variable.speed > 0 ? variable.speed : 1)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -6,
          0
        ],
        "linear_drag_coefficient": 2.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.24 * (1 - v.particle_age / v.particle_lifetime)",
          0.05
        ],
        "facing_camera_mode": "lookat_direction"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFF0E0",
            "0.2": "#FFFF4040",
            "0.7": "#FFB00010",
            "1.0": "#00400004"
          }
        }
      }
    }
  }
}