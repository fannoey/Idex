{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "idex:reaper_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/reaper/smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 6)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "(variable.radius > 0 ? variable.radius : 0.4)",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.9) * (variable.life > 0 ? variable.life : 1)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3, 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 1.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 0.6) * (0.6 + 0.9 * v.particle_age / v.particle_lifetime)",
          "(variable.size > 0 ? variable.size : 0.6) * (0.6 + 0.9 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "uv": {
            "texture_width": 256,
            "texture_height": 64,
            "uv": [
              "math.floor(v.particle_random_1 * 4) * 64",
              0
            ],
            "uv_size": [
              64,
              64
            ]
          }
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-30, 30)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#0008040A",
            "0.12": "#FF08040A",
            "0.5": "#FF1A0509",
            "1.0": "#001A0509"
          }
        }
      }
    }
  }
}