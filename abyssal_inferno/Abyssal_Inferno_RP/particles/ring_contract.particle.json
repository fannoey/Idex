{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:ring_contract",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/ring"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.rad = v.radius > 0 ? v.radius : 5; v.lf = v.life > 0 ? v.life : 0.45;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0.06,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.lf"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0.0
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.max(0.2, v.rad * 2.33 * (1 - math.pow(v.particle_age / v.particle_lifetime, 2)))",
          "math.max(0.2, v.rad * 2.33 * (1 - math.pow(v.particle_age / v.particle_lifetime, 2)))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFE0FF",
            "0.2": "#FFD070FF",
            "0.5": "#FFB0207A",
            "1.0": "#00300030"
          }
        }
      }
    }
  }
}
