{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:sigil",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/sigil"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.rad = v.radius > 0 ? v.radius : 3.0; v.lf = v.life > 0 ? v.life : 1.2;"
