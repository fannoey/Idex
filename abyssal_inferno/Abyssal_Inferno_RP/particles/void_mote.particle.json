{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:void_mote",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.6,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.4)"
      },
      "minecraft:particle_initial_speed": "math.random(0.1, 0.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.5,
          0
        ],
        "linear_drag_coefficient": 1.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.08 + v.particle_random_2 * 0.08) * (1 - 0.5 * v.particle_age / v.particle_lifetime)",
          "(0.08 + v.particle_random_2 * 0.08) * (1 - 0.5 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00F0D0FF",
            "0.08": "#FFD7A8FF",
            "0.3": "#FF9A4DFF",
            "0.6": "#FF5A12C8",
            "0.85": "#AA2A0670",
            "1.0": "#00100030"
          }
        }
      }
    }
  }
}
