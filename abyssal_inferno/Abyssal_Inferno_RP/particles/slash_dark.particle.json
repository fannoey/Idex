          "(v.size > 0 ? v.size : 2.2) * 1.12"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 384,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              64,
              0
            ],
            "frames_per_second": 24,
            "max_frame": 6,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00000000",
            "0.1": "#E0100010",
            "0.7": "#A0080008",
            "1.0": "#00000000"
