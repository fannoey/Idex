{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:explosion_flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/glow"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.rad = v.radius > 0 ? v.radius : 3;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.rad * 1.5 * math.sqrt(math.max(0, 1 - v.particle_age / v.particle_lifetime))",
          "v.rad * 1.5 * math.sqrt(math.max(0, 1 - v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.3": "#FFFF4A6A",
            "0.7": "#FFA020E0",
            "1.0": "#00300040"
          }
        }
      }
    }
  }
}
