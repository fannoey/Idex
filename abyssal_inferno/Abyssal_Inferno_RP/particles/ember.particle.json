{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:ember",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.5,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.7, 1.3)"
      },
      "minecraft:particle_initial_speed": "math.random(0.4, 1.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.0,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.06 + v.particle_random_2 * 0.05) * (1 - 0.6 * v.particle_age / v.particle_lifetime)",
          "(0.06 + v.particle_random_2 * 0.05) * (1 - 0.6 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFE0B0",
            "0.2": "#FFFF5A2A",
            "0.6": "#FFC01A9A",
            "1.0": "#00400050"
          }
        }
      }
    }
  }
}
