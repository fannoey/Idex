{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:implode",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/glow"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.rad = v.radius > 0 ? v.radius : 3;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.rad",
        "surface_only": true,
        "direction": "inwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.45
      },
      "minecraft:particle_initial_speed": "v.rad * 2.2",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3 * (1 - 0.8 * v.particle_age / v.particle_lifetime)",
          "0.3 * (1 - 0.8 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00F0D0FF",
            "0.08": "#FFD7A8FF",
            "0.3": "#FF9A4DFF",
            "0.6": "#FF5A12C8",
            "0.85": "#AA2A0670",
            "1.0": "#00100030"
          }
        }
      }
    }
  }
}
