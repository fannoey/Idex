{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:zone_motes",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/glow"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.rad = v.radius > 0 ? v.radius : 4; v.lf = v.life > 0 ? v.life : 4;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 20,
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": "v.emitter_age > v.lf - 0.6"
      },
      "minecraft:emitter_shape_disc": {
        "radius": "v.rad",
        "plane_normal": [
          0,
          1,
          0
        ],
        "offset": [
          0,
          0.1,
          0
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.2)"
      },
      "minecraft:particle_initial_speed": "math.random(0.1, 0.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 * (1 - 0.5 * v.particle_age / v.particle_lifetime)",
          "0.12 * (1 - 0.5 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00F0D0FF",
            "0.08": "#FFD7A8FF",
            "0.3": "#FF9A4DFF",
            "0.6": "#FF5A12C8",
            "0.85": "#AA2A0670",
            "1.0": "#00100030"
          }
        }
      }
    }
  }
}
