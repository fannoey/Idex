{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/flame_sheet"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.h = v.height > 0 ? v.height : 2.6;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "v.h * 0.4",
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.65)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          3,
          0
        ],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.h * 0.32 * (1 - 0.5 * v.particle_age / v.particle_lifetime)",
          "v.h * math.min(1, v.particle_age / v.particle_lifetime * 6)"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 256,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              64
            ],
            "step_UV": [
              32,
              0
            ],
            "frames_per_second": 16,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFD6A0",
            "0.08": "#FFFFB070",
            "0.3": "#FFFF3B1F",
            "0.6": "#FFB0102E",
            "0.85": "#AA4A0A5A",
            "1.0": "#00200028"
          }
        }
      }
    }
  }
}
