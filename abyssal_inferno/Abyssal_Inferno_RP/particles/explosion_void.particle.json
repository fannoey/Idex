{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:explosion_void",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/flame_sheet"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.rad = v.radius > 0 ? v.radius : 3;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 24
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.4,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.55, 0.95)"
      },
      "minecraft:particle_initial_speed": "v.rad * math.random(2.0, 3.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.5,
          0
        ],
        "linear_drag_coefficient": 3.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.7 + v.particle_random_1 * 0.6) * (1 - 0.4 * v.particle_age / v.particle_lifetime)",
          "(1.2 + v.particle_random_1 * 0.9) * (1 - 0.4 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 256,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              64
            ],
            "step_UV": [
              32,
              0
            ],
            "frames_per_second": 16,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00F0D0FF",
            "0.08": "#FFD7A8FF",
            "0.3": "#FF9A4DFF",
            "0.6": "#FF5A12C8",
            "0.85": "#AA2A0670",
            "1.0": "#00100030"
          }
        }
      }
    }
  }
}
