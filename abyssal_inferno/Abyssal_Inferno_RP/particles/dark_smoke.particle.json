{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:dark_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/abyss/smoke_sheet"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 1.6)"
      },
      "minecraft:particle_initial_speed": "math.random(0.2, 0.5)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-30, 30)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5 + v.particle_age / v.particle_lifetime * 0.9 + v.particle_random_1 * 0.3",
          "0.5 + v.particle_age / v.particle_lifetime * 0.9 + v.particle_random_1 * 0.3"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              32,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00000000",
            "0.15": "#C01A0C1E",
            "0.6": "#8012081A",
            "1.0": "#00000000"
          }
        }
      }
    }
  }
}
