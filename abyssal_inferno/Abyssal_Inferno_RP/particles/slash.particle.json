              64,
              0
            ],
            "frames_per_second": 24,
            "max_frame": 6,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.06": "#FFFFC4D0",
            "0.25": "#FFFF2A3A",
            "0.55": "#FFB21CC8",
