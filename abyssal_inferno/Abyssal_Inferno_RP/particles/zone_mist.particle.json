{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:zone_mist",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/abyss/smoke_sheet"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.rad = v.radius > 0 ? v.radius : 4; v.lf = v.life > 0 ? v.life : 4;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 18,
        "max_particles": 50
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": "v.emitter_age > v.lf - 0.8"
      },
      "minecraft:emitter_shape_disc": {
        "radius": "v.rad",
        "plane_normal": [
          0,
          1,
          0
        ],
        "offset": [
          0,
          0.25,
          0
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.2, 1.8)"
      },
      "minecraft:particle_initial_speed": 0.15,
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-20, 20)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.2,
          0
        ],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.0 + v.particle_age / v.particle_lifetime * 0.7",
          "1.0 + v.particle_age / v.particle_lifetime * 0.7"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              32,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00000000",
            "0.2": "#90200838",
            "0.7": "#70100620",
            "1.0": "#00000000"
          }
        }
      }
    }
  }
}
