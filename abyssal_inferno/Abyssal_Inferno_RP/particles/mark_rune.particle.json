{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:mark_rune",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/mark_sheet"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.stk = math.clamp(math.floor(v.stack) - 1, 0, 4);"
