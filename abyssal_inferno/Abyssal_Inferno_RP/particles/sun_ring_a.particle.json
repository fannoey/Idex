{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "abyss:sun_ring_a",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/abyss/flame_sheet"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 70,
        "max_particles": 140
      },
      "minecraft:emitter_lifetime_once": {
