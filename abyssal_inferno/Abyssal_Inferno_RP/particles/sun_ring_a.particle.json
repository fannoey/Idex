      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.45, 0.7)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "((math.cos((v.particle_random_1 * 360 + v.particle_age * 300)) * (1.7 * (v.emitter_age > 4.55 ? math.max(0.08, 1 - (v.emitter_age - 4.55) / 0.45) : math.min(1, v.emitter_age / 0.35)))) * 1.0000 - (math.sin((v.particle_random_1 * 360 + v.particle_age * 300)) * (1.7 * (v.emitter_age > 4.55 ? math.max(0.08, 1 - (v.emitter_age - 4.55) / 0.45) : math.min(1, v.emitter_age / 0.35))) * 0.8660) * 0.0000)",
          "(math.sin((v.particle_random_1 * 360 + v.particle_age * 300)) * (1.7 * (v.emitter_age > 4.55 ? math.max(0.08, 1 - (v.emitter_age - 4.55) / 0.45) : math.min(1, v.emitter_age / 0.35))) * 0.5000)",
          "((math.cos((v.particle_random_1 * 360 + v.particle_age * 300)) * (1.7 * (v.emitter_age > 4.55 ? math.max(0.08, 1 - (v.emitter_age - 4.55) / 0.45) : math.min(1, v.emitter_age / 0.35)))) * 0.0000 + (math.sin((v.particle_random_1 * 360 + v.particle_age * 300)) * (1.7 * (v.emitter_age > 4.55 ? math.max(0.08, 1 - (v.emitter_age - 4.55) / 0.45) : math.min(1, v.emitter_age / 0.35))) * 0.8660) * 1.0000)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.33 * (1 - 0.4 * v.particle_age / v.particle_lifetime)",
          "0.55 * (1 - 0.4 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              64
            ],
            "step_UV": [
              32,
              0
            ],
            "frames_per_second": 16,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFD6A0",
            "0.08": "#FFFFB070",
            "0.3": "#FFFF3B1F",
            "0.6": "#FFB0102E",
            "0.85": "#AA4A0A5A",
            "1.0": "#00200028"
          }
        }
      }
    }
  }
